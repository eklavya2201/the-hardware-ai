# Add these blocks to ~/synqit/deploy/aws/Caddyfile on the box.
#
# Stage one: studio.synqit.in, so the new studio can be used against the real
# engine and the real accounts while synqit.in still serves the current app.
studio.synqit.in {
	encode gzip
	reverse_proxy studio:3000
}

# Stage two, once studio.synqit.in has been used in anger: point the apex here
# too. This replaces CloudFront as the front door, so it also means moving the
# Route 53 A-alias for synqit.in (and www) off the CloudFront distribution and
# onto this box's Elastic IP, 3.111.115.126. Caddy then issues the apex
# certificate itself.
#
# synqit.in, www.synqit.in {
# 	encode gzip
# 	reverse_proxy studio:3000
# }
