# Runtime secrets for the studio container. Copy to studio.env on the box.
# Anything VITE_* belongs in the build args instead -- it is baked into the
# client bundle and is not a secret.

# LLM (Azure OpenAI on the `aatreus` resource)
AZURE_RESOURCE_NAME=aatreus
AZURE_OPENAI_API_KEY=

# Supabase (conversations, studio accounts, preview storage)
SUPABASE_SERVICE_ROLE_KEY=

# Where the studio is reachable, for webhooks that call back in
WEBHOOK_BASE_URL=https://synqit.in

# Bypasses the upstream billing service
ENVIRONMENT=local

# Optional: Octopart/Nexar part search
NEXAR_CLIENT_ID=
NEXAR_CLIENT_SECRET=
