# Synqit CAD — local environment. Copy to .env.local (git-ignored) or, easier,
# let scripts/bootstrap.mjs generate it. Lines marked REQUIRED are all you need
# to run the app locally; everything else is optional.

# --- Supabase (REQUIRED; printed by `npx supabase status -o env`) ------------
VITE_SUPABASE_URL='http://127.0.0.1:54321'
VITE_SUPABASE_ANON_KEY="<ANON_KEY>"
SUPABASE_SERVICE_ROLE_KEY="<SERVICE_ROLE_KEY>"

# --- LLM (REQUIRED: at least one provider) ----------------------------------
# Azure OpenAI (what we use): picker ids azure/gpt-5.1 and azure/gpt-5-pro
AZURE_RESOURCE_NAME="aatreus"
AZURE_OPENAI_API_KEY="<ask the repo owner>"
# Upstream providers, only if you have keys (enable the other picker entries)
# ANTHROPIC_API_KEY=""
# GOOGLE_API_KEY=""
# OPENROUTER_API_KEY=""

# --- Mode (REQUIRED) --------------------------------------------------------
ENVIRONMENT="local"                     # bypasses billing: every user gets 3M tokens
SYNQIT_APP_URL="http://localhost:3000"
WEBHOOK_BASE_URL="http://localhost:3000"
VITE_SENTRY_ENVIRONMENT="local"

# --- No-auth mode (dev/demo only) -------------------------------------------
# With both set, every visitor is auto signed in as this account and the login
# screen never shows. Remove both to restore Google / Synqit / email sign-in.
# NEVER set these on a public deployment.
VITE_GUEST_EMAIL="guest@synqit.in"
VITE_GUEST_PASSWORD="<any password; bootstrap generates one>"

# --- Synqit integration (optional) ------------------------------------------
# Same Google OAuth client id the Synqit frontend uses; the CAD origin must be
# in that client's "Authorized JavaScript origins" or Google shows origin_mismatch.
VITE_GOOGLE_CLIENT_ID=""
# Synqit backend for "Continue with Synqit" (needs the cad-sso branch running)
VITE_SYNQIT_API_BASE="http://localhost:8000/api"
SYNQIT_API_BASE="http://localhost:8000/api"

# --- Optional upstream features ---------------------------------------------
# FAL_KEY=""                            # mesh / "Creative" mode (Hunyuan3D, Meshy) + image gen
# NGROK_URL=""                          # public tunnel so fal.ai can call the webhook
# VITE_POSTHOG_PROJECT_KEY=""
# VITE_SENTRY_DSN=""
# BILLING_SERVICE_URL="" ; BILLING_SERVICE_KEY=""   # real billing (not needed in local mode)
# VITE_SSO_PROVIDER="" ; VITE_ACCOUNT_URL=""        # upstream custom-OIDC mode, unused
# ACCOUNT_PURGE_SECRET=""
